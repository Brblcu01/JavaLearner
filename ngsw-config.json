{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.json", "/*.css", "/*.js"]
      }
    },
    {
      "name": "questions",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/questions/*.json"]
      }
    },
    {
      "name": "images",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/icon.webp", "/icons/*.png"]
      }
    },
    {
      "name": "fonts",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "urls": ["https://fonts.googleapis.com/**", "https://fonts.gstatic.com/**"]
      }
    }
  ]
}
